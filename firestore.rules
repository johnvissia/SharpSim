/**
 * Core Philosophy: This ruleset supports a client-side data caching model for public sports data and user-specific betting.
 *
 * Public Data (/daily_games, /completed_games, /system):
 * - Public Read Access: All game and system data is public and readable by anyone.
 * - Authenticated Writes: To prevent anonymous abuse, only signed-in users can write to these collections, which is necessary for the client-side data fetching model.
 *
 * User Data (/users):
 * - Owner-Only Access: Users can only read and write their own data. A user can create their own profile and bets, and update them. This is critical for security. The `gradeUserBets` function runs on the client, so it can only update the bets of the currently logged-in user, which these rules enforce.
 *
 * Key Security Decisions:
 *   - No Data Validation: In line with prototyping, these rules focus on authorization, not data validation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------------
    // Public Collections
    // ------------------------------------------------------------------------
    match /daily_games/{gameId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    match /completed_games/{gameId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    match /system/{statusId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }
    
    // ------------------------------------------------------------------------
    // User-Specific Collections
    // ------------------------------------------------------------------------

    /**
     * @description Controls access to user profile documents. Users can create, read, and update their own profile, but cannot delete it or access others' profiles.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get, update, create: if isOwner(userId);
      // Deny reads/writes to the entire collection.
      allow list, delete: if false;

      /**
       * @description Controls access to a user's subcollection of bets. Users can manage their own bets fully.
       * @path /users/{userId}/bets/{betId}
       */
      match /bets/{betId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }
  }
}
