/**
 * Core Philosophy: This ruleset supports public sports data reads and authenticated user betting.
 *
 * Public Data (/daily_games, /completed_games, /system, /rankings, /player_props, /model_predictions, etc.):
 * - Public Read Access: All game, system, ranking, and prop data is public and readable by anyone.
 * - Admin-Only Client Writes: Only verified administrator accounts can write directly from client.
 *   Automated ingestion and pipelines use the Firebase Admin SDK (which bypasses rules).
 *
 * User Data (/users):
 * - Owner-Only Access: Users can only read and write their own data. A user can create their own profile and bets, and update them.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.uid in [
          'bbISx7lZZiWXWJsdLk2NGjYTSdp2',
          '8n7fi9dV1LTnHpPUac4EEwxq1pB3',
          'JadnfCXFFuWsCwT34Ib4FawR8Yr2',
          'oVf8IM2uGkZv3qmYi5DvyTRqGnz2'
        ]
      );
    }

    // ------------------------------------------------------------------------
    // Public Collections
    // ------------------------------------------------------------------------
    match /daily_games/{gameId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /completed_games/{gameId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /system/{statusId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /rankings/{teamName} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /player_props/{propId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /model_predictions/{predictionId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /nba_team_stats/{teamId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /ncaam_team_stats/{teamId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /completed_player_stats/{statId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    // ------------------------------------------------------------------------
    // User-Specific Collections
    // ------------------------------------------------------------------------

    /**
     * @description Controls access to user profile documents. Users can create, read, and update their own profile, but cannot delete it or access others' profiles.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get, update, create: if isOwner(userId);
      // Deny reads/writes to the entire collection.
      allow list, delete: if false;

      /**
       * @description Controls access to a user's subcollection of bets. Users can manage their own bets fully.
       * @path /users/{userId}/bets/{betId}
       */
      match /bets/{betId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      /**
       * @description Controls access to a user's activity tracking data.
       * @path /users/{userId}/activity/{activityId}
       */
      match /activity/{activityId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }
  }
}
