/**
 * Production Security Rules for SharpSim
 *
 * Core Principles:
 * 1. Public Sports Data: Read-only for all public visitors. Writes restricted strictly to Admins / Backend Pipelines.
 * 2. User Data Integrity:
 *    - Users can only read their own profile.
 *    - Users CANNOT modify `isPro` or `membershipTier` directly from the client.
 *    - Users CANNOT artificially inflate `balance` (balance can only decrement or stay equal; rewards & bet wins come from Admin SDK).
 * 3. Bet Protection:
 *    - Users can ONLY create bets in 'pending' status with positive stakes and matching userId.
 *    - Users CANNOT alter existing bets or mark them as 'won' (prevents fraudulent payouts).
 *      Bet grading and settlements are performed exclusively via server-side Admin SDK pipelines.
 * 4. Promo Code Privacy:
 *    - Promo codes cannot be listed or read directly by clients; redemption is handled via /api/redeem-promo.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.uid in [
          'bbISx7lZZiWXWJsdLk2NGjYTSdp2',
          '8n7fi9dV1LTnHpPUac4EEwxq1pB3',
          'JadnfCXFFuWsCwT34Ib4FawR8Yr2',
          'oVf8IM2uGkZv3qmYi5DvyTRqGnz2'
        ]
      );
    }

    // ------------------------------------------------------------------------
    // Public Collections (Read-only for public, writes restricted to Admin)
    // ------------------------------------------------------------------------
    match /daily_games/{gameId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /completed_games/{gameId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /system/{statusId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /rankings/{teamName} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /player_props/{propId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /model_predictions/{predictionId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /nba_team_stats/{teamId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /ncaam_team_stats/{teamId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /mlb_team_stats/{teamId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /completed_player_stats/{statId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Promo Codes: Restricted to Admin/Server to prevent database listing/scraping
    match /promoCodes/{codeId} {
      allow get, list, write: if isAdmin();
    }
    
    // ------------------------------------------------------------------------
    // User-Specific Collections
    // ------------------------------------------------------------------------

    /**
     * @description Controls access to user profile documents.
     * Users can create and read their profile, and update general preferences.
     * Client cannot spoof `isPro`, `membershipTier`, or increase `balance`.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPro', 'membershipTier']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance']) || request.resource.data.balance <= resource.data.balance)
      ) || isAdmin();
      allow list, delete: if isAdmin();

      /**
       * @description Controls access to a user's bets.
       * Users can only create bets in 'pending' status with positive stakes.
       * Users CANNOT update bets (grading is performed solely by server-side Admin SDK).
       * @path /users/{userId}/bets/{betId}
       */
      match /bets/{betId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) 
          && request.resource.data.status == 'pending'
          && request.resource.data.stake > 0
          && request.resource.data.userId == userId;
        allow update: if isAdmin();
        allow delete: if (isOwner(userId) && resource.data.status == 'pending') || isAdmin();
      }

      /**
       * @description Controls access to a user's activity tracking data.
       * @path /users/{userId}/activity/{activityId}
       */
      match /activity/{activityId} {
        allow get, list, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}
